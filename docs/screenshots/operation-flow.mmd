%%{init: {"theme": "base", "themeVariables": {"primaryColor": "#e8f6f4", "primaryTextColor": "#1a3a36", "primaryBorderColor": "#0e9f8e", "lineColor": "#4a6b66", "secondaryColor": "#fff6e8", "tertiaryColor": "#f4f7f6", "fontFamily": "Microsoft YaHei, PingFang SC, sans-serif", "fontSize": "16px"}}}%%
flowchart TD
  Start(["打开 http://localhost:5173"]) --> List["/trips 行程列表"]

  List --> Create["新建「周末青岛两日游」<br/>青岛 · 两日 · 预算 1500"]
  Create --> PostTrip["POST /api/trips"]
  PostTrip --> Card["列表出现该行程卡片"]

  Card --> Detail["点击进入 /trips/:id"]
  Detail --> Load["并行 GET<br/>行程 / 景点 / 费用 / summary"]

  Load --> AddSpot["加 2 个景点/活动<br/>POST .../spots"]
  AddSpot --> Done["将其中 1 个标为「已去」<br/>PATCH /api/spots/:id"]

  Done --> AddExp["记 2 笔费用<br/>POST .../expenses"]
  AddExp --> Sum["GET .../summary<br/>已花 / 预算 / 使用率"]
  Sum --> Over{"合计 > 预算？"}
  Over -->|是| Alert["超支提醒"]
  Over -->|否| Ok["预算进度正常"]
  Alert --> NavAI
  Ok --> NavAI

  NavAI["顶栏进入 /assistant"] --> Fill["填目的地 / 天数 / 预算<br/>可从刚建的行程预填"]
  Fill --> Suggest["POST /api/ai/suggest"]
  Suggest --> Src{"source？"}
  Src -->|deepseek| Real["绿色：DeepSeek 真实调用"]
  Src -->|mock| Mock["橙色：Mock 降级 + 原因"]
  Real --> Show["展示日程 · 预算拆分 · tips"]
  Mock --> Show

  Show --> Imp{"一键导入清单？<br/>附录 A 可选"}
  Imp -->|跳过| Finish(["主线演示结束"])
  Imp -->|导入| Pick["选目标行程并勾选条目"]
  Pick --> Valid{"行程和条目都选了？"}
  Valid -->|否| Warn["前端提示，不发请求"]
  Warn --> Pick
  Valid -->|是| Bulk["POST .../spots/bulk<br/>事务整批写入"]
  Bulk --> Back["跳回 /trips/:id<br/>清单可见导入项"]
  Back --> Finish

  Card -.-> Del["旁支：列表点删除并确认"]
  Del --> Cascade["DELETE /api/trips/:id<br/>级联清除 spots + expenses"]

  classDef startEnd fill:#0e9f8e,stroke:#0b7a6d,color:#fff
  classDef page fill:#e8f6f4,stroke:#0e9f8e,color:#1a3a36
  classDef api fill:#f4f7f6,stroke:#7a8f8b,color:#1a3a36
  classDef branch fill:#fff6e8,stroke:#d4a017,color:#1a3a36
  classDef side fill:#f7f0f0,stroke:#c47a7a,color:#1a3a36,stroke-dasharray: 5 5

  class Start,Finish startEnd
  class List,Create,Card,Detail,AddSpot,Done,AddExp,NavAI,Fill,Show,Pick,Back page
  class PostTrip,Load,Sum,Suggest,Bulk,Cascade api
  class Over,Src,Imp,Valid,Alert,Ok,Real,Mock,Warn branch
  class Del side
